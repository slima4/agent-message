#!/usr/bin/env python3
# ruff: noqa: E401, E701, E702
from __future__ import annotations

import hashlib, json, os, re, sys, time, unicodedata
from pathlib import Path

__version__ = "1.2.1"

ALIAS_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")  # C0 minus \t\n, plus DEL — display sanitizer
# Body chars printed per inbox run. Bounds a hostile/buggy peer appending a huge
# record: unbounded bodies would exhaust the reading agent's context. Every
# elision is announced — a silently truncated body reads as an empty one.
BUDGET = 8000
# Largest body send/reply will write. Messages carry references, not payloads: a
# body past this can't be consumed by a reading agent (it displays as one line
# plus an elision) and taxes every future scan of the log, permanently — logs are
# append-only. Tune here; keep in step with MSG_MAX_BODY in shell/msg.sh.
MAX_BODY = 65536


def D() -> Path:
    if env := os.environ.get("AGENT_MESSAGE_DIR"):
        return Path(env)
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home()/".local"/"state")
    return Path(state)/"agent-message"


def _ok(a: str | None) -> str | None:
    return a if a and ALIAS_RE.match(a) else None


def me() -> str:
    p = Path(".agent-message")
    if p.is_file():
        try:
            for ln in p.read_text(encoding="utf-8").splitlines():
                s = _ok(ln.strip())
                if s: return s
        except (OSError, UnicodeDecodeError): pass
    return _ok(Path.cwd().name) or "unknown"


def cid(m: dict) -> str:
    c = {k: m[k] for k in ("ts","from","to","thread","body") if k in m}
    if "body" in c: c["body"] = unicodedata.normalize("NFC", c["body"])
    return hashlib.sha256(json.dumps(c, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()).hexdigest()[:16]


def _sane(s: str) -> str:
    return CTRL_RE.sub("", s)


def _reject_oversize(body: str, op: str) -> None:
    if len(body) > MAX_BODY:
        sys.exit(f"{op}: body is {len(body)} chars, limit {MAX_BODY} — send a path or link instead")


def thread_of(body: str, frm: str) -> tuple[str, str]:
    m = re.match(r"\s*\[thread:([^\]]+)\]\s*", body)
    if m:
        # Control chars (incl. \t\n) stripped; must match shell/msg.sh exactly (id parity).
        t = re.sub(r"[\x00-\x1f\x7f]", "", m.group(1)).strip()
        body = body[m.end():]
        if t: return t, body
    first = body.splitlines()[0] if body else ""
    slug = re.sub(r"[^a-z0-9]+", "-", first.lower()).strip("-")[:40] or "msg"
    return f"{time.strftime('%Y-%m-%d', time.gmtime())}-{frm}-{slug}", body


def _aw(p: Path, s: str) -> bool:
    # with_name (not with_suffix) so dotted aliases like "host.local" don't
    # collapse to ".seen-host.tmp". pid suffix: concurrent readers of the same
    # alias must not share a tmp name.
    # Returns False instead of raising when the dir is not writable: a sandboxed
    # agent (Codex workspace-write, read-only sync mount) must still be able to
    # READ its messages. Losing the watermark re-shows them; crashing loses them.
    tmp = p.with_name(f"{p.name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(s, encoding="utf-8")
        os.replace(str(tmp), str(p))
    except OSError:
        try: tmp.unlink()
        except OSError: pass
        return False
    return True


def _warn_unsaved(d: Path) -> None:
    print(f"note: read marker not saved ({d} not writable) — these show again next time",
          file=sys.stderr)


def _logs(d: Path) -> list[Path]:
    return [p for p in sorted(d.glob("log-*.jsonl")) if not p.is_symlink()]


def _alias_of(lf: Path) -> str:
    # Loud-fail: silent slice drift via §5 would wipe inboxes (also survives `python3 -O`).
    n = lf.name
    if not (n.startswith("log-") and n.endswith(".jsonl")): raise AssertionError(n)
    return n[4:-6]


def iter_to(d: Path, who: str):
    seen = set()
    for lf in _logs(d):
        file_alias = _alias_of(lf)
        if not ALIAS_RE.match(file_alias): continue
        with open(lf, encoding="utf-8", errors="replace") as f:
            for ln in f:
                ln = ln.strip()
                if not ln: continue
                try: m = json.loads(ln)
                except json.JSONDecodeError: continue
                # One malformed foreign record must not brick the reader: require §2 types.
                if not (isinstance(m, dict) and isinstance(m.get("ts"), (int, float))
                        and all(isinstance(m.get(k), str) for k in ("from","to","thread","body"))): continue
                if m["from"] != file_alias: continue
                if m["to"] != who: continue
                i = m.get("id")
                if not (isinstance(i, str) and i): i = cid(m)
                # Dedup scoped by sender: a forged id in another writer's log
                # must not suppress the genuine record.
                if (file_alias, i) in seen: continue
                seen.add((file_alias, i))
                yield i, m


def write(d: Path, frm: str, to: str, thread: str, body: str) -> dict:
    body = unicodedata.normalize("NFC", body)
    rec = {"ts": int(time.time()), "from": frm, "to": to, "thread": thread, "body": body}
    rec = {"id": cid(rec), **rec}
    d.mkdir(parents=True, exist_ok=True)
    fd = os.open(d/f"log-{frm}.jsonl", os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    return rec


def send(args: list[str]) -> None:
    if not args: sys.exit("usage: send <to>")
    to = args[0]
    if not _ok(to): sys.exit(f"send: recipient alias {to!r} fails SAMP §1 alias regex")
    if sys.stdin.isatty():
        sys.exit("send: pipe body via stdin, e.g. echo 'hi' | agent-message-cmd send <to>")
    # NFC before thread_of so slug (and therefore id) matches shell/msg.sh on non-NFC input.
    body = unicodedata.normalize("NFC", sys.stdin.read().rstrip("\n"))
    _reject_oversize(body, "send")
    frm = me()
    thread, body = thread_of(body, frm)
    rec = write(D(), frm, to, thread, body)
    print(f"sent {frm}→{to} thread={thread} id={rec['id']}")


def reply(args: list[str]) -> None:
    who = me()
    if sys.stdin.isatty():
        sys.exit("reply: pipe body via stdin, e.g. echo 'lgtm' | agent-message-cmd reply")
    body = sys.stdin.read().rstrip("\n")
    _reject_oversize(body, "reply")
    d = D()
    mine = [m for _, m in iter_to(d, who)]
    if not mine: sys.exit("no inbox messages to reply to")
    newest_ts = max(m["ts"] for m in mine)
    newest = [m for m in mine if m["ts"] == newest_ts]
    # Only a cross-sender tie is unrecoverable: §5 makes each sender's log
    # single-writer append-only, so line order within one log is arrival order.
    targets = {m["from"]: m for m in newest}
    if len(targets) > 1:
        lines = [f"reply: {len(targets)} senders tie at newest ts={newest_ts}; refusing ambiguous reply"]
        for frm, m in sorted(targets.items()):
            first = _sane(m["body"].splitlines()[0][:80]) if m["body"] else ""
            lines.append(f"  {frm}  [thread:{_sane(m['thread'])}]  {first}")
        lines.append("pick one: send <alias>, body prefixed with the matching [thread:...] above")
        sys.exit("\n".join(lines))
    last = newest[-1]
    rec = write(d, who, last["from"], last["thread"], body)
    print(f"reply {who}→{last['from']} thread={_sane(last['thread'])} id={rec['id']}")


def inbox(args: list[str]) -> None:
    mode = args[0] if args else "default"
    last = 0
    # Numeric mode = bounded re-read (git log -2): the n latest, read or not.
    # Distinct from default, which is bounded by unread, not by count. `all` is
    # unbounded in message count, so on a long archive it floods the reader.
    # ASCII digits only, matching shell/msg.sh's `*[!0-9]*` test exactly. str.isdigit()
    # accepts superscripts ('²') that int() then rejects, and Arabic-Indic digits the
    # shell would not — one crashes, the other diverges.
    if re.fullmatch(r"[0-9]+", mode):
        last, mode = int(mode), "all"
        if last < 1: sys.exit("inbox <n>: count must be >= 1")
    elif mode not in ("default", "all", "raw"): sys.exit(f"unknown mode: {mode}")
    who = me(); d = D()
    d.mkdir(parents=True, exist_ok=True)
    sf = d / f".seen-{who}"
    mf = d / f".mtime-{who}"
    now = int(time.time())
    cur_max = 0.0; cur_count = 0; cur_size = 0
    if mode == "default":
        stats = [p.stat() for p in d.glob("log-*.jsonl") if not p.is_symlink()]
        cur_max = max((s.st_mtime for s in stats), default=0.0)
        cur_count = len(stats)
        # Size is the third signal: same-tick appends and sync deliveries that
        # preserve an older sender mtime are invisible to (mtime, count) alone.
        cur_size = sum(s.st_size for s in stats)
        if mf.exists() and sf.exists():
            try:
                c = json.loads(mf.read_text(encoding="utf-8"))
                if c.get("max_mtime", 0) >= cur_max and c.get("files", 0) == cur_count and c.get("size", -1) == cur_size:
                    print(f"no new messages (as {who})"); return
            except ValueError: pass
    since, since_ids = 0, set()
    if mode == "default" and sf.exists():
        try:
            c = json.loads(sf.read_text(encoding="utf-8"))
            # Cap at local now: self-heals a watermark pushed into the future.
            since, since_ids = min(c.get("ts", 0), now), set(c.get("ids", []))
        except ValueError: pass
    out = []; allm = []
    for i, m in iter_to(d, who):
        t = m["ts"]; k = f"{m['from']}:{i}"
        allm.append((k, t))
        if mode == "default" and (t < since or k in since_ids): continue
        out.append((i, m))
    out.sort(key=lambda x: x[1]["ts"])
    total = len(out)
    if last: out = out[-last:]
    if not out:
        print(f"{'no new messages' if mode == 'default' else 'no messages'} (as {who})")
        if mode == "default": _aw(mf, json.dumps({"max_mtime": cur_max, "files": cur_count, "size": cur_size}))
        return  # nothing shown, so an unwritable cache costs nothing worth warning about
    if mode == "raw":
        for _, m in out:
            print(json.dumps(m, ensure_ascii=False))
        return
    # Bodies in both default and all: `all` is the re-read mode, and re-reading is
    # exactly when the body is wanted. The budget bounds the output, not the mode.
    bodies = [_sane(m["body"]).strip("\n") for _, m in out]
    full, left = set(), BUDGET
    for x in range(len(out) - 1, -1, -1):  # newest first — the budget should buy the newest
        if len(bodies[x]) <= left: left -= len(bodies[x]); full.add(x)
    for n, (i, m) in enumerate(out):
        t = time.strftime("%m-%d %H:%M", time.localtime(m["ts"]))
        print(f"[{t}] from={m['from']} id={i[:8]} thread={_sane(m['thread'])}:")
        body = bodies[n]
        shown = body if n in full else (body.splitlines()[0][:80].rstrip() if body else "")
        # Every body line indented: a body mimicking a header line can't impersonate one.
        for ln in (shown.splitlines() or ["(empty)"]): print("  " + ln if ln else "")
        if len(shown) < len(body): print(f"  … +{len(body) - len(shown)} chars elided — 'inbox raw' for full text")
    if mode == "default":
        # Watermark capped at local now so a fast-clock sender can't advance it
        # past honest senders; ids carry every shown record with ts >= the cap.
        shown = {f"{m['from']}:{i}" for i, m in out}
        new_since = min(now, max(m["ts"] for _, m in out))
        new_ids = sorted(k for k, t in allm if t >= new_since and (k in shown or k in since_ids))
        ok = _aw(sf, json.dumps({"ts": new_since, "ids": new_ids}))
        ok = _aw(mf, json.dumps({"max_mtime": cur_max, "files": cur_count, "size": cur_size})) and ok
        if not ok: _warn_unsaved(d)
    senders = sorted({m["from"] for _, m in out})
    # "new" only in default: all re-reads already-seen messages, none of them new.
    # A bounded re-read says what it withheld, same rule as body elision.
    lbl = f"{len(out)} of {total}" if last else f"{len(out)} {'new' if mode == 'default' else 'total'}"
    print(f"{lbl} from: {', '.join(senders)} (as {who})")


OPS = {"send": send, "inbox": inbox, "reply": reply}

if __name__ == "__main__":
    for _std in (sys.stdin, sys.stdout):
        # UTF-8 regardless of locale; replace on output so a bare 'C' locale can't
        # crash the status print after a record already landed on disk.
        getattr(_std, "reconfigure", lambda **_: None)(encoding="utf-8", errors="replace")
    if len(sys.argv) >= 2 and sys.argv[1] in ("--version", "-V"):
        print(f"agent-message {__version__} (SAMP v1)")
        sys.exit(0)
    if len(sys.argv) < 2 or sys.argv[1] not in OPS:
        sys.exit(f"usage: {Path(sys.argv[0]).name} {{{'|'.join(OPS)}}} [args]  (--version)")
    OPS[sys.argv[1]](sys.argv[2:])
